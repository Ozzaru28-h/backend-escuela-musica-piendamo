# Copia este archivo como .env y ajusta los valores
PORT=3000
# MongoDB local (usa 127.0.0.1 y no "localhost": en Node 17+ localhost puede resolver a IPv6 y fallar)
MONGODB_URI=mongodb://127.0.0.1:27017/escuela_musica_piendamo
# Si usas MongoDB Atlas, pega aquí tu cadena de conexión (mongodb+srv://...)
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d
